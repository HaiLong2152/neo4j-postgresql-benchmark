# Copy to .env and set both benchmark passwords. Use single quotes for literal $ or #.
BENCHMARK_NEO4J_PASSWORD=
BENCHMARK_POSTGRES_PASSWORD=

# Initial resource settings for environment checks. Tune them on the benchmark host.
BENCHMARK_NEO4J_CPUS=2.0
BENCHMARK_NEO4J_MEMORY_LIMIT=2g
BENCHMARK_NEO4J_HEAP_INITIAL=512m
BENCHMARK_NEO4J_HEAP_MAX=512m
BENCHMARK_NEO4J_PAGE_CACHE=512m

BENCHMARK_NEO4J_HTTP_PORT=7475
BENCHMARK_NEO4J_BOLT_PORT=7688
BENCHMARK_NEO4J_USER=neo4j
BENCHMARK_NEO4J_DATABASE=neo4j

BENCHMARK_POSTGRES_CPUS=2.0
BENCHMARK_POSTGRES_MEMORY_LIMIT=2g
BENCHMARK_POSTGRES_SHARED_BUFFERS=256MB
BENCHMARK_POSTGRES_WORK_MEM=4MB
BENCHMARK_POSTGRES_MAINTENANCE_WORK_MEM=64MB
BENCHMARK_POSTGRES_PORT=5433
BENCHMARK_POSTGRES_USER=postgres
BENCHMARK_POSTGRES_DB=fraud_benchmark
